# Copia in ".env" e riempi. NON committare mai il file ".env" reale.

DATABASE_URL="file:./licenses.db"

# Segreto per le route /admin/licenses (creazione/gestione licenze) — una stringa lunga
# e casuale, la usi tu (chi vende le licenze) per autenticare le chiamate admin, es. con:
# curl -H "x-admin-secret: IL_TUO_SEGRETO" ...
LICENSE_ADMIN_SECRET="cambia-questo-in-una-stringa-lunga-e-casuale-almeno-16-caratteri"

PORT=5000
