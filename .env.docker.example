# Copia questo file in ".env.docker" e riempilo PRIMA di "docker compose up".
# NON committare mai ".env.docker" (contiene segreti reali).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""

# --- Telegram MTProto (cartelle chat reali, opzionale) ---
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# --- Cifratura credenziali su DB ---
ENCRYPTION_KEY=""

# --- LLM Provider di default (poi configurabile per singola creator dal pannello) ---
LLM_PROVIDER="deepseek"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
DEEPSEEK_API_KEY=""

# --- Admin panel auth ---
# In produzione (NODE_ENV=production, già impostato da docker-compose.yml) il server
# si rifiuta di avviarsi se questa chiave è assente o più corta di 32 caratteri.
ADMIN_JWT_SECRET="cambia-questo-in-una-stringa-lunga-e-casuale-almeno-32-caratteri"
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="cambia-questa-password"
