# Copia questo file in ".env" e riempi i valori. NON committare mai il file ".env" reale.

# --- Database ---
DATABASE_URL="file:./prisma/dev.db"

# --- Telegram ---
# Token del bot ottenuto da @BotFather. Uno per ciascun bot/creator, oppure
# un solo bot "gateway" che smista per creatorId (vedi README, sezione "Multi-bot").
TELEGRAM_BOT_TOKEN=""

# --- Telegram MTProto (cartelle chat REALI, brief pagina 1) ---
# Ottieni API_ID e API_HASH gratis registrando un'app su https://my.telegram.org/apps
# con il numero dell'account Telegram che vuoi usare per gestire le cartelle reali.
# Il login (numero + codice SMS) si completa una tantum dal pannello admin
# (Fan & Cartelle → Cartelle Telegram Reali), non da qui.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# Chiave dedicata per cifrare le credenziali (API key LLM, token bot, sessione MTProto)
# salvate su DB. Se lasciata vuota, si deriva da ADMIN_JWT_SECRET come fallback: sconsigliato
# in produzione, perché lega la sicurezza dell'auth a quella delle credenziali cifrate.
ENCRYPTION_KEY=""

# --- LLM Provider ---
# Il default REALE per ogni nuova creator è "ollama" (locale, vedi routes/creators.ts) —
# DeepSeek/Anthropic/OpenAI vietano tutti contenuto sessualmente esplicito nei loro ToS.
# Questa variabile è solo un fallback usato se una creator non ha un provider proprio.
LLM_PROVIDER="ollama"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
DEEPSEEK_API_KEY=""

# --- Admin panel auth ---
ADMIN_JWT_SECRET="cambia-questo-in-una-stringa-lunga-e-casuale"
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="cambia-questa-password"

# --- Server ---
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# --- Licenza commerciale (phone-home verso apps/license-server) ---
# Lascia ENTRAMBE vuote per un'installazione interna/di sviluppo (nessuna restrizione).
# Compilale solo se questa è un'installazione VENDUTA a un cliente: LICENSE_KEY è la
# chiave fornita dal venditore (formato NUGIS-XXXX-XXXX-XXXX-XXXX), LICENSE_SERVER_URL
# è l'indirizzo del server di licenze del venditore (es. http://ufficio-ip:5000).
LICENSE_SERVER_URL=""
LICENSE_KEY=""
